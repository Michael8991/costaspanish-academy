# MongoDB connection used by the public course catalogue.
MONGO_URI=

# Server-only API key used to send transactional form emails.
RESEND_API_KEY=

# Optional Cloudflare Turnstile protection. Configure both values together.
# The secret must remain server-only.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional Google Tag Manager container. It remains disabled in local development.
# Set a valid GTM-... ID only in production and in previews approved for analytics.
NEXT_PUBLIC_GTM_ID=
